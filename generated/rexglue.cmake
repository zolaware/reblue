    message(
      FATAL_ERROR
        "ReXGlue SDK not found. Set REXSDK_DIR to the rexglue-sdk source tree "
        "(e.g. thirdparty/rexglue-sdk)\n"
        "or install the SDK package and add it to CMAKE_PREFIX_PATH"
    )
  endif ()
