    ""
    CACHE STRING "Override SDK version (leave empty for default)"
)

# Find SDK
set(REXSDK_DIR
    ""
    CACHE PATH "Path to rexglue-sdk source tree"
)
if (REXSDK_DIR)
  add_subdirectory("${REXSDK_DIR}" rexglue-sdk)
  message(STATUS "Using ReXGlue SDK from source tree: ${REXSDK_DIR}")
else ()
  if (REXSDK_VERSION)
    find_package(rexglue ${REXSDK_VERSION} EXACT QUIET CONFIG)
  else ()
    find_package(rexglue 0.11.0 QUIET CONFIG)
  endif ()
