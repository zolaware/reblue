# Applies the SDK settings, include paths and codegen dependency to a host library.
macro (rexglue_setup_host_library library_name)
  rexglue_apply_target_settings(${library_name})
  target_include_directories(
    ${library_name} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_CURRENT_SOURCE_DIR}/src
                               ${REXGLUE_ENTRYPOINT_INCLUDE_DIR}
  )
  target_link_libraries(${library_name} PRIVATE rex::sdk)
  add_dependencies(${library_name} reblue_codegen)
endmacro ()

# Configure a rexglue target with SDK libraries and platform settings.
macro (rexglue_setup_target target_name)
  if (REXGLUE_ENTRYPOINT_GENERATED_SOURCES AND NOT TARGET reblue_recompiled)
    add_library(reblue_recompiled OBJECT ${REXGLUE_ENTRYPOINT_GENERATED_SOURCES})
    target_include_directories(
      reblue_recompiled PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_CURRENT_SOURCE_DIR}/src
                                ${REXGLUE_ENTRYPOINT_INCLUDE_DIR}
    )
    target_link_libraries(reblue_recompiled PRIVATE rex::sdk)
    set_source_files_properties(
      ${REXGLUE_ENTRYPOINT_GENERATED_SOURCES} PROPERTIES COMPILE_OPTIONS ""
    )
    rexglue_apply_target_settings(reblue_recompiled)
    rexglue_apply_recomp_settings(
      reblue_recompiled
      "${REXGLUE_ENTRYPOINT_INCLUDE_DIR}/${REXGLUE_ENTRYPOINT_PREFIX}_pch.h"
    )
    add_dependencies(reblue_recompiled reblue_codegen)
  endif ()
  if (TARGET reblue_recompiled)
    target_link_libraries(${target_name} PRIVATE reblue_recompiled)
  endif ()
  # Also on the host, so a tree that has never run codegen generates it.
  add_dependencies(${target_name} reblue_codegen)
  target_include_directories(
    ${target_name} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_CURRENT_SOURCE_DIR}/src
                              ${REXGLUE_ENTRYPOINT_INCLUDE_DIR}
  )
  target_link_libraries(${target_name} PRIVATE rex::sdk)
  if (EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/metadata/icons")
    rexglue_embed_metadata(
      ${target_name} DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/metadata/icons" PREFIX "icons"
    )
  endif ()
  rexglue_configure_target(${target_name} ${ARGN})
endmacro ()

# Codegen runs as part of the build, re-running only when an input in codegen.d
# or REXGLUE_RECOMP_MAX_FILE_SIZE changes. A run that changes the list of sources
# regenerates the build files before anything compiles them.
# Listing the sources as outputs orders any target that compiles them after
# codegen, including one a project assembles itself rather than taking the
# library rexglue_setup_target() builds.
set(_rexglue_codegen_max_file_size)
if (REXGLUE_RECOMP_MAX_FILE_SIZE)
  set(_rexglue_codegen_max_file_size MAX_FILE_SIZE "${REXGLUE_RECOMP_MAX_FILE_SIZE}")
endif ()
rexglue_add_codegen(
  reblue_codegen
  MANIFEST "${CMAKE_CURRENT_SOURCE_DIR}/reblue_manifest.toml"
  OUTPUT_DIR "${CMAKE_CURRENT_SOURCE_DIR}/generated"
  WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
  TOOL $<TARGET_FILE:rex::rexglue> ${_rexglue_codegen_max_file_size}
  SOURCES ${REXGLUE_ENTRYPOINT_GENERATED_SOURCES}
)

# Include DLL module shared library targets if codegen has generated them
if (EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/generated/dll_targets.cmake")
  include(generated/dll_targets.cmake)
endif ()
