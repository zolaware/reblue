{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "re:Blue",
  "repo": "zolaware/reblue",
  "game": {
    "kind": "iso_or_folder",
    "label": "Your three Global-release Blue Dragon disc ISOs together in one folder. Select DVD 1 or that folder; setup finds DVD 2 and DVD 3 by their contents.",
    "check": { "xdvdfs": "bd_disc_1.xml" }
  },
  "prepare": {
    "program": ["reblue.exe", "reblue.AppImage", "reblue", "reblue.app/Contents/MacOS/reblue"],
    "args": ["--prepare-content", "--game-dir", "{game}", "--install-dir", "{install}"],
    "label": "Checking and installing all three Blue Dragon discs",
    "timeout": 3600
  },
  "start": {
    "program": ["reblue.exe", "reblue.AppImage", "reblue", "reblue.app/Contents/MacOS/reblue"],
    "args": ["--recomplauncher-play", "--install-dir", "{install}"]
  },
  "config": [
    { "id": "main", "format": "toml", "file": [{ "path": "{install}/profiles/default/reblue.toml" }] }
  ],
  "settings": [
    {
      "id": "resolution", "label": "Resolution",
      "choices": [
        { "label": "Auto", "set": { "resolution": "\"\"" } },
        { "label": "720p", "set": { "resolution": "\"1280x720\"" } },
        { "label": "1080p", "set": { "resolution": "\"1920x1080\"" } },
        { "label": "1440p", "set": { "resolution": "\"2560x1440\"" } },
        { "label": "4K", "set": { "resolution": "\"3840x2160\"" } }
      ],
      "defaults": { "resolution": "\"\"" }
    },
    {
      "id": "display", "label": "Display mode",
      "choices": [
        { "label": "Windowed", "set": { "fullscreen": "false", "fullscreen_exclusive": "false" } },
        { "label": "Borderless", "set": { "fullscreen": "true", "fullscreen_exclusive": "false" } },
        { "label": "Full screen", "set": { "fullscreen": "true", "fullscreen_exclusive": "true" } }
      ],
      "defaults": { "fullscreen": "true", "fullscreen_exclusive": "false" }
    },
    {
      "id": "fps", "label": "Frame rate",
      "help": "Rates above 30 interpolate the game's fixed 30 Hz simulation.",
      "choices": [
        { "label": "30 fps", "set": { "bd_fps_limit": "30" } },
        { "label": "60 fps", "set": { "bd_fps_limit": "60" } },
        { "label": "90 fps", "set": { "bd_fps_limit": "90" } },
        { "label": "120 fps", "set": { "bd_fps_limit": "120" } },
        { "label": "Unlimited", "set": { "bd_fps_limit": "0" } }
      ],
      "defaults": { "bd_fps_limit": "0" }
    },
    {
      "id": "vsync", "label": "V-Sync",
      "choices": [ { "label": "Off", "set": { "bd_vsync": "false" } }, { "label": "On", "set": { "bd_vsync": "true" } } ],
      "defaults": { "bd_vsync": "true" }
    },
    {
      "id": "aspect", "label": "Aspect ratio",
      "choices": [
        { "label": "Auto", "set": { "bd_aspect_ratio": "5" } },
        { "label": "16:9", "set": { "bd_aspect_ratio": "0" } },
        { "label": "4:3", "set": { "bd_aspect_ratio": "1" } },
        { "label": "16:10", "set": { "bd_aspect_ratio": "2" } },
        { "label": "21:9", "set": { "bd_aspect_ratio": "3" } },
        { "label": "32:9", "set": { "bd_aspect_ratio": "4" } },
        { "label": "Stretch", "set": { "bd_aspect_ratio": "6" } }
      ],
      "defaults": { "bd_aspect_ratio": "5" }
    },
    {
      "id": "msaa", "label": "Anti-aliasing",
      "choices": [
        { "label": "Off", "set": { "bd_msaa": "0" } },
        { "label": "2x MSAA", "set": { "bd_msaa": "2" } },
        { "label": "4x MSAA", "set": { "bd_msaa": "4" } },
        { "label": "8x MSAA", "set": { "bd_msaa": "8" } }
      ],
      "defaults": { "bd_msaa": "4" }
    },
    {
      "id": "anisotropy", "label": "Texture filtering",
      "choices": [
        { "label": "Game default", "set": { "bd_anisotropy": "0" } },
        { "label": "2x", "set": { "bd_anisotropy": "2" } },
        { "label": "4x", "set": { "bd_anisotropy": "4" } },
        { "label": "8x", "set": { "bd_anisotropy": "8" } },
        { "label": "16x", "set": { "bd_anisotropy": "16" } }
      ],
      "defaults": { "bd_anisotropy": "16" }
    },
    {
      "id": "dof", "label": "Depth of field",
      "choices": [
        { "label": "Off", "set": { "bd_dof_strength": "0.0" } },
        { "label": "Half", "set": { "bd_dof_strength": "0.5" } },
        { "label": "Original", "set": { "bd_dof_strength": "1.0" } }
      ],
      "defaults": { "bd_dof_strength": "1.0" }
    }
  ],
  "folders": {
    "saves": [{ "path": "{install}/profiles/default/saves" }],
    "logs": [{ "path": "{install}/logs" }]
  },
  "saves": ["{install}/profiles/default/saves", "{install}/profiles/default/achievements", "{install}/profiles/default/reblue.toml"],
  "actions": [
    { "id": "saves", "label": "Save folder", "open": "saves" },
    { "id": "logs", "label": "Logs", "open": "logs" }
  ],
  "exit_codes": {
    "1": "re:Blue could not prepare or start. Check the setup output, all three Global-release discs, and the installation folder.",
    "2": "Invalid RecompLauncher command. Reinstall this release and retry."
  }
}
